{
  "name": "well-information-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "dotenv": "^17.2.1",
    "express": "^4.21.2",
    "kafkajs": "^2.2.4",
    "pg": "^8.16.3",
    "pino": "^9.8.0",
    "pino-http": "^11.0.0",
    "zod": "^4.0.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.2",
    "@types/node": "^20.19.9",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
