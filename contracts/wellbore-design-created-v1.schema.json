{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ongc.example/contracts/wellbore-design-created-v1.schema.json",
  "title": "WellboreDesignCreatedV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "aggregateType",
    "aggregateId",
    "aggregateVersion",
    "occurredAtUtc",
    "correlationId",
    "causationId",
    "producer",
    "data"
  ],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "const": "WellboreDesignCreated" },
    "eventVersion": { "const": 1 },
    "aggregateType": { "const": "WellboreDesign" },
    "aggregateId": { "type": "string", "format": "uuid" },
    "aggregateVersion": { "type": "integer", "minimum": 1 },
    "occurredAtUtc": { "type": "string", "format": "date-time" },
    "correlationId": { "type": "string", "minLength": 1 },
    "causationId": { "type": ["string", "null"] },
    "producer": { "const": "well-information-api" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wellboreDesignId",
        "company",
        "project",
        "site",
        "well",
        "wellbore",
        "design",
        "ownerName",
        "designType",
        "milestones",
        "createdAtUtc"
      ],
      "properties": {
        "wellboreDesignId": { "type": "string", "format": "uuid" },
        "company": { "type": "string", "minLength": 1, "maxLength": 100 },
        "project": { "type": "string", "minLength": 1, "maxLength": 100 },
        "site": { "type": "string", "minLength": 1, "maxLength": 100 },
        "well": { "type": "string", "minLength": 1, "maxLength": 100 },
        "wellbore": { "type": "string", "minLength": 1, "maxLength": 100 },
        "design": { "type": "string", "minLength": 1, "maxLength": 100 },
        "ownerName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "designType": { "enum": ["Standard", "Montage"] },
        "milestones": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["milestoneType", "occurredAt"],
            "properties": {
              "milestoneType": {
                "enum": [
                  "GnG data received",
                  "MDT conducted",
                  "Design initiated",
                  "Sent to DFS",
                  "Received from DFS",
                  "Sent to cementing team",
                  "Received from cementing team",
                  "Approvals initiated",
                  "Approvals Level 1",
                  "Approvals Level 2",
                  "Approvals Level 3"
                ]
              },
              "occurredAt": { "type": "string", "format": "date-time" }
            }
          }
        },
        "createdAtUtc": { "type": "string", "format": "date-time" }
      }
    }
  }
}
